// moonn2k: NMEA 2000 protocol toolkit in pure MoonBit
name = "CGYH/moonn2k"

version = "0.1.1"

readme = "README.md"

repository = "https://github.com/CGYH/moonn2k"

license = "Apache-2.0"

keywords = [ "nmea2000", "can", "marine", "protocol", "codec" ]

preferred_target = "wasm"

description = "Pure MoonBit NMEA 2000 protocol toolkit: CAN ID/PGN, single frame, Fast Packet, typed PGN codecs, simulator and CLI."
